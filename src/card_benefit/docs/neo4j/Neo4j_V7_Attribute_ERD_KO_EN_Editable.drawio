<mxfile host="app.diagrams.net" modified="2026-11-03T05:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="actual" name="Neo4j 영문 한글 속성 ERD"><mxGraphModel dx="3600" dy="2200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3800" pageHeight="2150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="note0" value="Neo4j 영문 + 한글 속성 상세 ERD · 노드 13종 / 124개 · 관계 14종 / 196개" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=NanumSquare;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="3480" height="40" as="geometry" /></mxCell><mxCell id="note1" value="dp_node: 124개 전체 노드에 공통으로 붙는 보조 라벨이며 별도 업무 노드가 아닙니다." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=NanumSquare;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="50" y="64" width="3480" height="32" as="geometry" /></mxCell><mxCell id="note2" value="● Neo4j NODE KEY · S=문자열 / I=정수 / B=불리언 · x/n=해당 속성 보유 건수. 한글 설명은 PostgreSQL DDL COMMENT와 실제 변환 구조를 참조했습니다." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=NanumSquare;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="50" y="103" width="3480" height="36" as="geometry" /></mxCell><mxCell id="dp_card_product" value="&lt;div style=&quot;font-family:NanumSquare,Arial;padding:5px;text-align:left&quot;&gt;&lt;div style=&quot;font-weight:bold;font-size:16px;color:#2563EB;&quot;&gt;dp_card_product&lt;/div&gt;&lt;div style=&quot;color:#475569;font-size:13px;margin-bottom:5px&quot;&gt;카드 상품 · 2개 노드&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #CBD5E1;margin:6px 0&quot;&gt;&lt;div style=&quot;font-size:12px;line-height:24px;&quot;&gt;&lt;span style=&quot;color:#2563EB&quot;&gt;●&lt;/span&gt; &amp;nbsp; &lt;b&gt;card_id&lt;/b&gt; &lt;span style=&quot;color:#64748B&quot;&gt; / 카드 아이디  [I]&lt;/span&gt;