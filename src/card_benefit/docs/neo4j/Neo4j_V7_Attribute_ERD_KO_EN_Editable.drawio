ltip="key: 그래프 식별키 / source_json: 원본 행/구조 JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4C94A4;fontColor=#4C94A4;fontSize=12;endArrow=block;endFill=1;strokeWidth=1.7;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge17" value="dp_on_page&lt;br&gt;해당 페이지에 위치 (10)" source="dp_card_doc_chunk" target="dp_card_doc_page" tooltip="key: 그래프 식별키 / source_json: 원본 행/구조 JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4C94A4;fontColor=#4C94A4;fontSize=12;endArrow=block;endFill=1;strokeWidth=1.7;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge18" value="dp_in_chunk&lt;br&gt;해당 청크에 포함 (35)" source="dp_card_source_evidence" target="dp_card_doc_chunk" tooltip="key: 그래프 식별키 / source_json: 원본 행/구조 JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4C94A4;fontColor=#4C94A4;fontSize=12;endArrow=block;endFill=1;strokeWidth=1.7;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="notes" name="속성 및 DB 매핑 참고"><mxGraphModel dx="1300" dy="800" grid="1" page="1" pageScale="1" pageWidth="1400" pageHeight="960"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="m0" value="&lt;b&gt;실제 Neo4j 상태&lt;/b&gt;&lt;br&gt;노드 124개 / 관계 196개. 공통 dp_node 라벨은 124개에 포함됩니다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=NanumSquare;fontSize=17;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1320" height="128" as="geometry" /></mxCell><mxCell id="m1" value="&lt;b&gt;원문 근거 식별자&lt;/b&gt;&lt;br&gt;PostgreSQL 복합 PK = 문서 아이디 + 페이지 번호 + 청크 아이디 + 원문 근거 아이디 / Neo4j NODE KEY = evidence_id." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=NanumSquare;fontSize=17;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1"><mxGeometry x="20" y="165" width="1320" height="128" as="geometry" /></mxCell><mxCell id="m2" value="&lt;b&gt;근거 연결 속성명 차이&lt;/b&gt;&lt;br&gt;PostgreSQL은 evidence_link_id / 현재 Neo4j dp_supported_by 관계에는 기존 속성 ev_link_id 사용." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=NanumSquare;fontSize=17;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="1320" height="128" as="geometry" /></mxCell><mxCell id="m3" value="&lt;b&gt;Neo4j에 없는 파이프라인 테이블&lt;/b&gt;&lt;br&gt;card_ai_run, card_ai_call, card_extr_stg, common_cd, common_code_grp, card_excl_item 등은 현재 13종 노드에 포함되지 않습니다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=NanumSquare;fontSize=17;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1"><mxGeometry x="20" y="455" width="1320" height="128" as="geometry" /></mxCell><mxCell id="m4" value="&lt;b&gt;JSONB 파생 노드&lt;/b&gt;&lt;br&gt;dp_bnft_rule, dp_rule_target, dp_cond_expr, dp_cond_branch, dp_cond_atom 은 PostgreSQL JSONB 구조에서 추출한 그래프 표현입니다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=NanumSquare;fontSize=17;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="1320" height="128" as="geometry" /></mxCell><mxCell id="m5" value="&lt;b&gt;한글 설명 출처&lt;/b&gt;&lt;br&gt;일반 PostgreSQL 필드는 2026-11-03 14:36 DDL COMMENT, 그래프 전용 키와 가상 노드는 매핑 의미를 기반으로 표시했습니다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=NanumSquare;fontSize=17;align=left;verticalAlign=middle;spacing=15;" vertex="1" parent="1"><mxGeometry x="20" y="745" width="1320" height="128" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>